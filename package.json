{
  "name": "strava-to-gcal",
  "version": "1.0.0",
  "description": "Serverless service to sync Strava activities to Google Calendar",
  "main": "src/app.js",
  "scripts": {
    "test": "NODE_OPTIONS='--no-deprecation' jest",
    "deploy": "npm run build:frontend && cd infrastructure && npx cdk deploy",
    "build:frontend": "cd frontend && npm run build",
    "local": "NODE_OPTIONS='--no-deprecation' node scripts/local-server.js",
    "local:mock": "NODE_OPTIONS='--no-deprecation' node scripts/local-server.js --mock-db",
    "webhook-setup": "NODE_OPTIONS='--no-deprecation' node scripts/strava-webhooks.js",
    "dlq:redrive": "NODE_OPTIONS='--no-deprecation' node scripts/redrive-dlq.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.980.0",
    "@aws-sdk/client-kms": "^3.1000.0",
    "@aws-sdk/client-sqs": "^3.995.0",
    "@aws-sdk/lib-dynamodb": "^3.980.0",
    "@react-oauth/google": "^0.13.4",
    "axios": "^1.13.5",
    "google-auth-library": "^10.5.0",
    "googleapis": "^126.0.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^8.16.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.0",
    "aws-sdk-client-mock": "^3.0.0",
    "jest": "^29.7.0"
  }
}